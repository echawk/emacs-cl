#!/bin/sh
# emcl -- run Emacs Common Lisp.  See `emcl --help'.

# Resolve symlinks so emcl can be linked into a directory on PATH.
self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname "$self")/$target ;;
    esac
done
root=$(cd "$(dirname "$self")/.." && pwd)

exec "${EMACS:-emacs}" -Q --batch -l "$root/lisp/emcl.el" -- "$@"
