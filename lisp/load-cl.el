;;; Functions for loading and compiling the whole system.

(let ((inhibit-message t))
  (require 'cl))
(require 'byte-compile "bytecomp")

(when (fboundp 'native-comp-available-p)
  (let ((eln-directory (expand-file-name ".eln" (file-name-directory load-file-name))))
    (when (file-directory-p eln-directory)
      (add-to-list 'native-comp-eln-load-path eln-directory))))

(setq max-lisp-eval-depth 10000)
(setq max-specpdl-size 10000)

;;; Fake IN-PACKAGE and FIND-PACKAGE until they are defined properly
;;; in cl-packages.el.
(defmacro IN-PACKAGE (name) nil)
(defun FIND-PACKAGE (name) nil)

;; `cl:defun' uses ERROR for argument validation while the package system is
;; being bootstrapped.  cl-conditions.el replaces this with the Common Lisp
;; condition machinery once it has been loaded.
(unless (fboundp 'ERROR)
  (defun ERROR (datum &rest args)
    (if (stringp datum)
        (apply #'error datum args)
      (error "%S" datum))))

(unless (fboundp 'cl-mapcar-many)
  (fset 'cl-mapcar-many (symbol-function 'cl--mapcar-many)))

(defvar *cl-files*
  '("utils"
    "func"

    "cl-evaluation"
    "cl-flow"
    "cl-numbers"
    "cl-conses"
    "cl-characters"
    "cl-strings"
    "cl-arrays"
    "cl-sequences"
    "cl-structures"
    "cl-iteration"

    "cl-symbols"
    "cl-packages"

    "cl-types"
    "cl-typep"
    "cl-subtypep"

    "cl-hash"
    "cl-streams"
    "cl-reader"
    "cl-printer"
    "cl-environment"
    "cl-filenames"
    "cl-files"
    "interaction"
    "cl-eval"
    "cl-system"

    "cl-loop"
    "cl-format"
    "cl-compile"
    "cl-conditions"

    "populate"))

(defvar *cl-eval-buffer-files*
  '("cl-compile"
    "cl-conditions"))

(defun load-cl-file (file)
  (if (member file *cl-eval-buffer-files*)
      (let* ((path (locate-library (concat file ".el")))
	     (load-file-name path)
	     (load-in-progress t))
	(unless path
	  (error "Cannot find %s" file))
	(message "Loading %s (source)..." path)
	(with-temp-buffer
	  (insert-file-contents path)
	  (condition-case nil
	      (while t
		(eval (read (current-buffer))))
	    (end-of-file t))))
    (load file)
    (message "Loaded %s..." file)))

(defun load-closette (dir)
  "Load closette (a reference CLOS/MOP implementation) as Common Lisp source.
Under :emacs-cl it defines the standard COMMON-LISP symbols in place rather
than shadowing them; USE-PACKAGE additionally exposes its extra exports."
  (message "Loading %s..." (expand-file-name "closette.lisp" dir))
  ;; Discard closette's bootstrap progress messages.
  (let ((*STANDARD-OUTPUT* (MAKE-BROADCAST-STREAM)))
    (LOAD (expand-file-name "closette.lisp" dir)))
  (USE-PACKAGE "CLOSETTE" (FIND-PACKAGE "EMACS-CL"))
  (load "cl-clos" nil t)
  (message "Loaded closette..."))

(defun load-cl ()
  (interactive)
  (let ((load-path (cons (file-name-directory load-file-name) load-path))
	(debug-on-error t)
	(byte-compile-warnings nil)
	(macroexp-inhibit-compiler-macros t)
	(warning-minimum-level :error)
	(warning-suppress-types '((obsolete))))
    (let ((old-byte-compile-warn-obsolete
	   (when (fboundp 'byte-compile-warn-obsolete)
	     (symbol-function 'byte-compile-warn-obsolete)))
	  (old-macroexp--obsolete-warning
	   (when (fboundp 'macroexp--obsolete-warning)
	     (symbol-function 'macroexp--obsolete-warning))))
      (unwind-protect
	  (progn
	    (when old-byte-compile-warn-obsolete
	      (fset 'byte-compile-warn-obsolete (lambda (&rest args) nil)))
	    (when old-macroexp--obsolete-warning
	      (fset 'macroexp--obsolete-warning (lambda (&rest args) nil)))
	    (mapc #'load-cl-file *cl-files*)
	    (populate-packages)
	    (load-closette (file-name-directory load-file-name))
	    (garbage-collect))
	(when old-byte-compile-warn-obsolete
	  (fset 'byte-compile-warn-obsolete old-byte-compile-warn-obsolete))
	(when old-macroexp--obsolete-warning
	  (fset 'macroexp--obsolete-warning old-macroexp--obsolete-warning))))))

(defun compile-cl (&optional native)
  "Compile emacs-cl.
With a prefix argument, or when EMACS_CL_COMPILER is `native', also native
compile the generated byte-code when this Emacs has libgccjit support."
  (interactive "P")
  (let ((byte-compile-warnings nil))
    (dolist (file *cl-files*)
      (byte-compile-file (concat file ".el"))))
  (when (or native (equal (getenv "EMACS_CL_COMPILER") "native"))
    (unless (and (fboundp 'native-comp-available-p)
                 (native-comp-available-p))
      (error "Native compilation requested, but libgccjit is unavailable"))
    (let ((native-comp-eln-load-path
           (list (expand-file-name ".eln" default-directory))))
      (make-directory (car native-comp-eln-load-path) t)
      (dolist (file *cl-files*)
        (native-compile (expand-file-name (concat file ".elc")))))))

(setq *global-environment*
      (vector 'environment
	      ;; Variable information
	      nil nil nil
	      ;; Function information
	      nil nil nil
	      ;; Block and tagbody information
	      nil nil))

(load-cl)
(IN-PACKAGE "CL-USER")
